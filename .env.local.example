# Copy this file to .env.local (gitignored — never commit the real values)
# and fill in the real secrets. Then, once per PowerShell terminal session,
# before running any npm script that needs them:
#
#   . .\scripts\load-env.ps1
#
# That loads every KEY=VALUE line below as a real $env: variable for the
# rest of that terminal session — every later `npm run ...` (build:electron,
# electron:dev, dist:win:publish, ...) then just sees them normally, the
# same as if you'd pasted them by hand each time.
#
# See README.md's "Releasing and auto-updates" and "Discord integration"
# sections for what each of these is, how to generate it, and the tradeoffs
# of each one shipping inside the built app.

# Write access to the repo — only used on this machine, when actually
# cutting a release (`npm run dist:win:publish`). Never baked into the app.
GH_TOKEN=

# Read-only, scoped to only this repo (Contents: Read-only). Baked into
# every build — ships inside the app, extractable by anyone who receives it.
KIYRO_UPDATE_TOKEN=

# Discord OAuth2 client secret, from the same Developer Portal page as the
# Client ID. Also baked into every build that has this set.
KIYRO_DISCORD_CLIENT_SECRET=
