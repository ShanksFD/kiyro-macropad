{
  "name": "kiyro",
  "version": "0.1.0",
  "private": true,
  "description": "Kiyro — macro pad configurator",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "typecheck:electron": "tsc --noEmit -p electron/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "build:electron": "tsc -p electron/tsconfig.json",
    "electron:dev": "concurrently -k \"next dev\" \"wait-on http://localhost:3000 && npm run build:electron && electron .\""
  },
  "dependencies": {
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.4.0",
    "@mui/material": "^9.4.0",
    "@mui/material-nextjs": "^9.4.0",
    "koffi": "^2.9.0",
    "next": "^16.3.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.86.0",
    "serialport": "^12.0.0",
    "zod": "^4.5.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.4",
    "@types/w3c-web-serial": "^1.0.8",
    "concurrently": "^9.1.0",
    "electron": "^33.2.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.3",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11",
    "wait-on": "^8.0.1"
  }
}
