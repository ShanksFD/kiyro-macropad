{
  "name": "kiyro",
  "version": "0.2.7",
  "private": true,
  "description": "Kiyro — macro pad configurator",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ShanksFD/kiyro-macropad.git"
  },
  "author": {
    "name": "Kiyro",
    "email": "anassookrat@gmail.com"
  },
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "typecheck:electron": "tsc --noEmit -p electron/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "build:electron": "node scripts/generate-build-secrets.mjs && tsc -p electron/tsconfig.json",
    "electron:dev": "concurrently -k \"next dev\" \"wait-on http://localhost:3000 && npm run build:electron && electron .\"",
    "dist:win": "npm run build && npm run build:electron && electron-builder --win",
    "dist:mac": "npm run build && npm run build:electron && electron-builder --mac",
    "dist:win:publish": "npm run build && npm run build:electron && node scripts/tag-release.mjs && electron-builder --win --publish always && node scripts/publish-github-release.mjs"
  },
  "dependencies": {
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.4.0",
    "@mui/material": "^9.4.0",
    "@mui/material-nextjs": "^9.4.0",
    "@sentry/electron": "^7.18.0",
    "@tabler/icons-react": "^3.46.0",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.9",
    "koffi": "^2.9.0",
    "next": "^16.3.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.86.0",
    "serialport": "^12.0.0",
    "zod": "^4.5.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.4",
    "@types/w3c-web-serial": "^1.0.8",
    "concurrently": "^9.1.0",
    "electron": "^33.2.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.3",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.kiyro.macropad",
    "productName": "Kiyro",
    "directories": {
      "output": "dist-installer"
    },
    "publish": {
      "provider": "github",
      "owner": "ShanksFD",
      "repo": "kiyro-macropad",
      "private": true
    },
    "files": [
      "dist-electron/**/*",
      "out/**/*",
      "package.json",
      "!**/*.map"
    ],
    "asarUnpack": [
      "**/*.node",
      "node_modules/koffi/**",
      "node_modules/@serialport/bindings-cpp/**"
    ],
    "win": {
      "icon": "electron/assets/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Kiyro",
      "artifactName": "${productName} Setup.${ext}",
      "uninstallDisplayName": "${productName}",
      "differentialPackage": false
    },
    "mac": {
      "icon": "electron/assets/icon.icns",
      "category": "public.app-category.utilities",
      "target": [
        "dmg"
      ]
    },
    "dmg": {
      "icon": "electron/assets/icon.icns"
    }
  }
}
